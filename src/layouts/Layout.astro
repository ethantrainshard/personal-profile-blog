---
import Nav from '../components/Nav.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import Footer from '../components/Footer.astro';
import { site, socialLinks, heroSubtitle } from '../config';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = site.defaultDescription,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const assetPath = (p: string) => base + '/' + p;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ethan Goh',
  jobTitle: heroSubtitle,
  url: site.ogUrl,
  sameAs: socialLinks
    .filter((link): link is NonNullable<typeof link> => link.href !== null)
    .map(link => link.href!),
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.ogUrl} />
    <meta property="og:image" content={site.ogUrl + 'og-image.png'} />
    <meta property="og:image:alt" content="Ethan Goh — Personal Profile" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.ogUrl + 'og-image.png'} />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
    <title>{title}</title>
    <link rel="stylesheet" href={assetPath('styles.css?v=4')} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Nav />
    <ScrollToTop />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .no-js {
    display: none;
  }
</style>
