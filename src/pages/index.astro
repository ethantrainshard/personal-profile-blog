---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import BlogCard from '../components/BlogCard.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { heroSubtitle, focusAreas, stats, projectThemes } from '../config';
import { getCollection } from 'astro:content';

const focusColorClasses = ['focus-color--link', 'focus-color--warning', 'focus-color--success'];
const glowColorClasses = ['focus-glow--link', 'focus-glow--warning', 'focus-glow--success'];
const focusDescriptions = [
  'Full-stack application development with modern frameworks, clean architecture, and test-driven practices.',
  'Application security, penetration testing, vulnerability assessment, and security-first development methodologies.',
  'Cloud architecture, CI/CD pipelines, containerization, and infrastructure as code for reliable deployments.',
];

const allProjects = await getCollection('projects');
const featuredProject = allProjects.find(p => p.data.featured);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recentPosts = sortedPosts.slice(0, 2);

const techColorToClass: Record<string, string> = {
  'var(--color-link)': 'skill-tag--link',
  'var(--color-warning)': 'skill-tag--warning',
  'var(--color-success)': 'skill-tag--success',
  'var(--color-body)': 'skill-tag--body',
};
---

<Layout title="Ethan Goh — Software Developer, Security Engineer, Infrastructure Architect">
  <section class="hero-band hero-band-gradient">
    <div class="hero-glow"></div>
    <div class="hero-band-content">
      <h1 class="display-xl">Ethan Goh</h1>
      <p class="caption-uppercase hero-band-subtitle">{heroSubtitle}</p>
      <p class="body-lg hero-band-body">
        Building secure, scalable systems from code to cloud. Specializing in software development, cybersecurity, and infrastructure deployment.
      </p>
      <div class="hero-band-cta">
        <Button text="View Projects" href="/projects" />
        <Button text="Read Blog" href="/blog" variant="secondary" />
      </div>
    </div>
    <div class="scroll-indicator" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 7L10 12L15 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="scroll-indicator-text">Scroll</span>
    </div>
  </section>

  <script client:load>
    const indicator = document.querySelector('.scroll-indicator');
    if (indicator) {
      const hideOnScroll = () => {
        if (window.scrollY > 100) {
          indicator.classList.add('hidden');
        } else {
          indicator.classList.remove('hidden');
        }
      };
      window.addEventListener('scroll', hideOnScroll, { passive: true });
      hideOnScroll();
    }
  </script>

  <ScrollReveal>
    <section class="stats-bar">
      <div class="container">
        <div class="stats-bar-inner">
          {stats.map(stat => (
            <div class="stat-item">
              <div class="stat-value">{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal>
    <section class="section">
      <div class="container">
        <div class="grid-3">
          {focusAreas.map((area, i) => (
            <a href={area.href} class:list={['focus-column', 'animate-on-scroll', `animate-delay-${i}`]} aria-label={`Learn more about ${area.label}`}>
              <div class:list={['focus-glow', glowColorClasses[i]]}></div>
              <h2 class:list={['title-md', focusColorClasses[i]]}>{area.label}</h2>
              <p class="body-md">{focusDescriptions[i]}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal>
    <section class="section">
      <div class="container">
        <div class="section-heading"><h2 class="display-lg">Featured Project</h2></div>
        <div class="featured-project-wrapper">
        {featuredProject && (
          <a href={`/projects/${featuredProject.slug}`} class:list={['featured-project', 'cursor-pointer', 'focus-visible-pointer']} aria-label={`View project: ${featuredProject.data.title}`}>
            <div class="featured-project-content">
              <h3 class="display-md featured-project-title">{featuredProject.data.title}</h3>
              <p class="body-lg featured-project-description">{featuredProject.data.description}</p>
              <div class:list={['skill-list', 'featured-project-skill-list']}>
                {featuredProject.data.techStack.map((tech, i) => (
                  <span class:list={['skill-tag', techColorToClass[featuredProject.data.techColors?.[i] || ''] || '']}>{tech}</span>
                ))}
              </div>
            </div>
           <div class="featured-project-image" aria-hidden="true">
              {(() => {
                const themeKey = featuredProject.data.visualTheme && projectThemes[featuredProject.data.visualTheme]
                  ? featuredProject.data.visualTheme
                  : 'default';
                const theme = projectThemes[themeKey];
                return (
                  <div class:list={['card-image-placeholder', `theme-${featuredProject.data.visualTheme || ''}`, 'card-image-fill']}>
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={theme.icon}></svg>
                  </div>
                );
              })()}
            </div>
          </a>
        )}
        </div>
        <div class="section-link-wrapper">
          <a href="/projects" class="section-link">View All Projects</a>
        </div>
      </div>
    </section>
  </ScrollReveal>

<ScrollReveal>
    <section class="section">
      <div class="container">
        <div class="section-heading"><h2 class="display-lg">Latest Writing</h2></div>

        <div class="grid-2">
          {recentPosts.map(post => (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              slug={post.slug}
              date={post.data.date}
              category={post.data.category}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>

        <div class="section-link-wrapper">
          <a href="/blog" class="section-link">Read More Posts</a>
        </div>
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal>
    <section class="section cta-band">
      <div class="container">
        <h2 class="display-lg">Let's Work Together</h2>
        <p class="body-lg cta-band-body">
          Have a project in mind? I'd love to hear about it.
        </p>
        <Button text="Get in Touch" href="/contact" />
      </div>
    </section>
  </ScrollReveal>
</Layout>
