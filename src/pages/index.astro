---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { heroSubtitle, focusAreas, focusAreaLinks } from '../config';
import { getCollection } from 'astro:content';

const focusColorClasses = ['focus-color--link', 'focus-color--warning', 'focus-color--success'];
const glowColorClasses = ['focus-glow--link', 'focus-glow--warning', 'focus-glow--success'];
const focusDescriptions = [
  'Full-stack application development with modern frameworks, clean architecture, and test-driven practices.',
  'Application security, penetration testing, vulnerability assessment, and security-first development methodologies.',
  'Cloud architecture, CI/CD pipelines, containerization, and infrastructure as code for reliable deployments.',
];

const allProjects = await getCollection('projects');
const previewProjects = allProjects
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);
---

<Layout title="Ethan Goh — Software Developer, Security Engineer, Infrastructure Architect">
  <section class="hero-band hero-band-gradient">
    <div class="hero-glow"></div>
    <div class="hero-band-content">
      <h1 class="display-xl">Ethan Goh</h1>
      <p class="caption-uppercase hero-band-subtitle">{heroSubtitle}</p>
      <p class="body-lg hero-band-body">
        Building secure, scalable systems from code to cloud. Specializing in software development, cybersecurity, and infrastructure deployment.
      </p>
      <div class="hero-band-cta">
        <Button text="View Projects" href="/projects" />
        <Button text="Read Blog" href="/blog" variant="secondary" />
      </div>
    </div>
  </section>

  <ScrollReveal>
    <section class="section">
      <div class="container">
        <div class="grid-3">
          {focusAreas.map((area, i) => (
            <a href={focusAreaLinks[i]} class:list={['focus-column', 'animate-on-scroll', `animate-delay-${i}`]} aria-label={`Learn more about ${area}`}>
              <div class:list={['focus-glow', glowColorClasses[i]]}></div>
              <h2 class:list={['title-md', focusColorClasses[i]]}>{area}</h2>
              <p class="body-md">{focusDescriptions[i]}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal>
    <section class="section">
      <div class="container">
        <div class="section-heading"><h2 class="display-lg">Selected Work</h2></div>
        <p class="caption-uppercase section-subtitle">Featured Projects</p>
        <div class="grid-2">
          {previewProjects.map(project => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              techStack={project.data.techStack}
              slug={project.slug}
              date={project.data.date}
              techColors={project.data.techColors}
              visualTheme={project.data.visualTheme}
            />
          ))}
        </div>
        <div class="section-link-wrapper">
          <a href="/projects" class="section-link">View All Projects</a>
        </div>
      </div>
    </section>
  </ScrollReveal>
</Layout>
