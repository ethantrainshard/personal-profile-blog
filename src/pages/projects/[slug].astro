---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { site } from '../../config';

type Entry = CollectionEntry<'projects'>;

const techColorToClass: Record<string, string> = {
  'var(--color-link)': 'skill-tag--link',
  'var(--color-warning)': 'skill-tag--warning',
  'var(--color-success)': 'skill-tag--success',
  'var(--color-body)': 'skill-tag--body',
};

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: project.data,
  }));
}

const { title, description, overview, features, techStack, techColors, role, date, githubUrl, liveUrl } = Astro.props;

const overviewHTML = `<p class="body-md">${overview.replace(/\n\n/g, '</p><p class="body-md">').replace(/\n/g, '<br />')}</p>`;
const descriptionHTML = `<p class="body-md">${description.replace(/\n\n/g, '</p><p class="body-md">').replace(/\n/g, '<br />')}</p>`;

const creativeWorkJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  dateCreated: date,
  author: {
    '@type': 'Person',
    name: 'Ethan Goh',
  },
  url: `${site.ogUrl}projects/${Astro.params.slug}`,
};
---

<Layout title={`${title} — Ethan Goh`}>
  <script type="application/ld+json" set:html={JSON.stringify(creativeWorkJsonLd)}></script>
  <section class="section">
    <div class="container">
      <a href="/projects" class="nav-link page-back-link">← Back to Projects</a>

      <div class="section-heading"><h1 class="display-lg">{title}</h1></div>
      <div class="flex-row-wrap">
        <p class="caption-uppercase">{date}</p>
      </div>

      <div class="project-meta">
        <div class="project-meta-item">
          <p class="caption-uppercase project-meta-label">Role</p>
          <p class="body-md">{role}</p>
        </div>
        <div class="project-meta-item">
          <p class="caption-uppercase project-meta-label">Tech Stack</p>
          <div class="skill-list">
            {techStack.map((tech, i) => (
              <span class:list={['skill-tag', techColorToClass[techColors?.[i] || ''] || '']}>{tech}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="project-content">
        <h2>Overview</h2>
        <div set:html={overviewHTML}></div>

        <h2>Key Features</h2>
        <ul>
          {features.map(feature => (
            <li class="body-md feature-item">{feature}</li>
          ))}
        </ul>

     <h2>Description</h2>
      <div set:html={descriptionHTML}></div>

        <div class="project-links">
          {githubUrl && <Button text="View Source" href={githubUrl} target="_blank" rel="noopener noreferrer" />}
          {liveUrl && <Button text="Live Demo" href={liveUrl} target="_blank" rel="noopener noreferrer" variant="secondary" />}
        </div>
      </div>
    </div>
  </section>
</Layout>
