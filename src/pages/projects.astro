---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { projectThemes } from '../config';

const base = import.meta.env.BASE_URL.trimEnd('/');
const projects = await getCollection('projects');
const featured = projects.find(p => p.data.featured);
const nonFeatured = projects.filter(p => !p.data.featured);

const techColorToClass: Record<string, string> = {
  'var(--color-link)': 'skill-tag--link',
  'var(--color-warning)': 'skill-tag--warning',
  'var(--color-success)': 'skill-tag--success',
  'var(--color-body)': 'skill-tag--body',
};
---

<Layout title="Projects — Ethan Goh">
  <section class="section">
    <div class="container">
      <div class="section-heading"><h1 class="display-lg">Projects</h1></div>
      <p class="caption-uppercase section-subtitle">Selected Work</p>

      {featured && (
        <div class="featured-project-wrapper">
          <p class="caption-uppercase featured-section-title">Featured Project</p>
          <a
            href={`${base}/projects/${featured.slug}`}
            class:list={['featured-project', 'cursor-pointer', 'focus-visible-pointer']}
            aria-label={`View project: ${featured.data.title}`}
          >
            <div class="featured-project-content">
              <div class="featured-project-info">
                <h2 class="display-md featured-project-title">{featured.data.title}</h2>
                <p class="body-lg featured-project-description">{featured.data.description}</p>
                <p class="body-sm featured-project-cta">Click to view full details →</p>
                <div class:list={['skill-list', 'featured-project-skill-list']}>
                  {featured.data.techStack.map((tech, i) => (
                    <span class:list={['skill-tag', techColorToClass[featured.data.techColors?.[i] || ''] || '']}>{tech}</span>
                  ))}
                </div>
                <div class="btn-group">
                  {featured.data.githubUrl && (
                    <span class="btn" role="link" tabindex="0" data-url={featured.data.githubUrl} onclick="event.stopPropagation(); window.open(this.dataset.url, '_blank');" onkeydown="if(event.key==='Enter'){event.stopPropagation(); window.open(this.dataset.url, '_blank');}">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                      Source
                    </span>
                  )}
                  {featured.data.liveUrl && (
                    <span class="btn btn-secondary" role="link" tabindex="0" data-url={featured.data.liveUrl} onclick="event.stopPropagation(); window.open(this.dataset.url, '_blank');" onkeydown="if(event.key==='Enter'){event.stopPropagation(); window.open(this.dataset.url, '_blank');}">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      Live Demo
                    </span>
                  )}
                </div>
              </div>
            </div>
           <div class="featured-project-image" aria-hidden="true">
              {(() => {
                const themeKey = featured.data.visualTheme && projectThemes[featured.data.visualTheme]
                  ? featured.data.visualTheme
                  : 'default';
                const theme = projectThemes[themeKey];
                return (
                  <div class:list={['card-image-placeholder', `theme-${featured.data.visualTheme || ''}`, 'card-image-fill']}>
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={theme.icon}></svg>
                  </div>
                );
              })()}
            </div>
          </a>
        </div>
      )}

      <div class="grid-2">
        {nonFeatured.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            techStack={project.data.techStack}
            slug={project.slug}
            date={project.data.date}
            techColors={project.data.techColors}
            visualTheme={project.data.visualTheme}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
