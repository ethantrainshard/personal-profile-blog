---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featured = projects.find(p => p.data.featured);
const nonFeatured = projects.filter(p => !p.data.featured);
---

<Layout title="Projects — Ethan Goh">
  <section class="section" style="padding-top: 120px;">
    <div class="container">
      <div class="section-heading"><h1 class="display-lg">Projects</h1></div>
      <p class="caption-uppercase" style="margin-bottom: var(--spacing-xxl); color: var(--color-link);">Selected Work</p>

      {featured && (
        <div style="margin-bottom: var(--spacing-xxl);">
          <p class="caption-uppercase" style="color: var(--color-link); margin-bottom: var(--spacing-lg); letter-spacing: 0.125rem;">Featured Project</p>
          <div class="featured-project" style="cursor: pointer;" onclick="window.location.href='/projects/{featured.slug}'">
            <div class="featured-project-content">
              <div class="featured-project-info">
                <h2 class="display-md" style="margin-bottom: var(--spacing-md);">{featured.data.title}</h2>
                <p class="body-lg" style="margin-bottom: var(--spacing-lg); color: var(--color-body); line-height: 1.7;">{featured.data.description}</p>
                <p class="body-sm" style="color: var(--color-link); margin-bottom: var(--spacing-xl);">Click to view full details →</p>
                <div class="skill-list" style="gap: var(--spacing-xs); margin-bottom: var(--spacing-xl);">
                  {featured.data.techStack.map((tech, i) => (
                    <span class="skill-tag" style={featured.data.techColors && featured.data.techColors[i] ? `border-color: ${featured.data.techColors[i]}; color: ${featured.data.techColors[i]};` : ''}>{tech}</span>
                  ))}
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-md);">
                  {featured.data.githubUrl && (
                    <a href={featured.data.githubUrl} class="btn" target="_blank" rel="noopener noreferrer" style="min-height: 44px;" onclick="event.stopPropagation()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: var(--spacing-xs);"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                      Source
                    </a>
                  )}
                  {featured.data.liveUrl && (
                    <a href={featured.data.liveUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer" style="min-height: 44px;" onclick="event.stopPropagation()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: var(--spacing-xs);"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      Live Demo
                    </a>
                  )}
                </div>
              </div>
            </div>
            <div class="featured-project-image" aria-hidden="true">
              <div class={`card-image-placeholder theme-${featured.data.visualTheme || ''}`} style="width: 100%; height: 100%; min-height: 240px;">
                {featured.data.visualTheme === 'secureci' && (
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                )}
                {featured.data.visualTheme === 'cloudforge' && (
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
                )}
                {featured.data.visualTheme === 'netsentinel' && (
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                )}
                {featured.data.visualTheme === 'vaultguard' && (
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>
                )}
                {!featured.data.visualTheme && (
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                )}
              </div>
            </div>
          </div>
        </div>
      )}

      <div class="grid-2">
        {nonFeatured.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            techStack={project.data.techStack}
            slug={project.slug}
            date={project.data.date}
            techColors={project.data.techColors}
            visualTheme={project.data.visualTheme}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .featured-project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    padding: var(--spacing-xl);
    transition: border-color 0.2s ease-out;
  }

  .featured-project:hover {
    border-color: var(--color-link);
  }

  .featured-project-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-project-image {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .featured-project {
      grid-template-columns: 1fr;
    }

    .featured-project-image {
      order: -1;
    }
  }
</style>
