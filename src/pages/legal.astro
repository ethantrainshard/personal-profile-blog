---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const base = import.meta.env.BASE_URL.trimEnd('/');
---

<Layout title="Legal — Privacy Policy & Terms of Service" description="Privacy policy and terms of service for cyberitdad.xyz.">
  <section class="section">
    <div class="container">
      <h1 class="display-md section-heading">Legal</h1>

      <div class="btn-group legal-nav">
        <a href="#privacy" class="section-link">Privacy Policy</a>
        <span class="caption-uppercase legal-nav-separator">·</span>
        <a href="#terms" class="section-link">Terms of Service</a>
      </div>

      <div class="post-content">
        <h2 id="privacy">Privacy Policy</h2>

        <h3>Information We Collect</h3>
        <p>
          When you use the contact form, we collect your name, email address, and message
          via Formspree. We do not store this data on our servers. No personal data is
          collected through browsing this site.
        </p>

        <h3>How We Use Information</h3>
        <p>
          Contact form submissions are used solely to respond to your inquiry.
          We do not sell, share, or trade your information with third parties.
        </p>

        <h3>Third-Party Services</h3>
        <p>
          <strong>Formspree</strong> — handles contact form submissions.
          See their privacy policy: <a href="https://formspree.io/privacy" target="_blank" rel="noopener noreferrer">formspree.io/privacy</a>
        </p>

        <h3>Cookies</h3>
        <p>
          This site does not use tracking cookies. Third-party services may set their
          own cookies per their respective policies.
        </p>

        <h3>Your Rights</h3>
        <p>
          You may request deletion of any contact form data by emailing
          <a href="mailto:info@cyberitdad.xyz">info@cyberitdad.xyz</a>.
          Formspree retains form data per their own retention policy.
        </p>

        <h3>Changes</h3>
        <p>
          This policy may be updated at any time. Last updated: May 2026.
        </p>

        <h3>Contact</h3>
        <p>
          For privacy-related inquiries, email
          <a href="mailto:info@cyberitdad.xyz">info@cyberitdad.xyz</a>.
        </p>

        <hr />

        <h2 id="terms">Terms of Service</h2>

        <h3>Usage</h3>
        <p>
          This site is a personal portfolio and blog. All content is provided for
          informational purposes only.
        </p>

        <h3>Content</h3>
        <p>
          All original content (text, code, designs) is owned by Ethan Goh unless
          otherwise noted. Blog posts may be shared with attribution and a link back
          to the original source.
        </p>

        <h3>Disclaimer</h3>
        <p>
          Content is provided "as is" without warranties of any kind. Technical advice
          is opinion-based — verify before applying to production systems. The author
          accepts no liability for damages arising from use of information on this site.
        </p>

        <h3>External Links</h3>
        <p>
          Links to third-party sites (GitHub, LinkedIn, etc.) are provided for
          convenience. We accept no responsibility for external site content or
          availability.
        </p>

        <h3>Changes</h3>
        <p>
          These terms may be updated at any time. Continued use of the site implies
          acceptance of the updated terms.
        </p>

        <h3>Governing Law</h3>
        <p>
          These terms are governed by the laws of Singapore.
        </p>

        <h3>Contact</h3>
        <p>
          For inquiries regarding these terms, email
          <a href="mailto:info@cyberitdad.xyz">info@cyberitdad.xyz</a>.
        </p>
      </div>

      <div class="back-btn-wrapper">
        <Button text="Back to Home" href={`${base}/`} variant="default" />
      </div>
    </div>
  </section>
</Layout>
