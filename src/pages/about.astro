---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { socialLinks, skills } from '../config';

const skillTagClassMap: Record<string, string> = {
  '--color-link': 'skill-tag--link',
  '--color-warning': 'skill-tag--warning',
  '--color-success': 'skill-tag--success',
};

const subheadingClassMap: Record<string, string> = {
  '--color-link': 'section-subheading--link',
  '--color-warning': 'section-subheading--warning',
  '--color-success': 'section-subheading--success',
};
---

<Layout title="About — Ethan Goh">
  <section class="section">
    <div class="container">
      <div class="section-heading"><h1 class="display-lg">About</h1></div>
      <p class="caption-uppercase section-subtitle">Background & Expertise</p>

      <div class="max-width-800">
        <p class="about-paragraph">
          I'm a software developer, security engineer, and infrastructure architect with over 8 years of experience building secure, scalable systems. My career spans from hands-on development to leading security initiatives and designing cloud-native infrastructure.
        </p>
        <p class="about-paragraph">
          I believe in security-first development — the idea that security shouldn't be an afterthought but a foundational principle woven into every line of code and every infrastructure decision. My experience across development, security, and operations gives me a unique perspective on building resilient systems.
        </p>
        <p class="about-paragraph--xl">
          When I'm not coding or configuring infrastructure, I write about cybersecurity, share lessons learned from production incidents, and contribute to open-source security tools.
        </p>

        {Object.values(skills).map(category => (
          <>
            <h2 class:list={['title-md', 'section-subheading', subheadingClassMap[category.colorVar] || 'section-subheading--hairline']}>{category.label}</h2>
            <div class="skill-list skill-list-wrapper">
              {category.tags.map(tag => (
                <span class:list={['skill-tag', skillTagClassMap[category.colorVar] || '']}>{tag}</span>
              ))}
            </div>
          </>
        ))}

        <h2 class="title-md section-subheading section-subheading--warning">Cybersecurity</h2>
        <div class="skill-list skill-list-wrapper">
          <span class="skill-tag skill-tag--warning">Penetration Testing</span>
          <span class="skill-tag skill-tag--warning">OWASP Top 10</span>
          <span class="skill-tag skill-tag--warning">Burp Suite</span>
          <span class="skill-tag skill-tag--warning">Threat Modeling</span>
          <span class="skill-tag skill-tag--warning">Security Auditing</span>
          <span class="skill-tag skill-tag--warning">Incident Response</span>
          <span class="skill-tag skill-tag--warning">SIEM</span>
          <span class="skill-tag skill-tag--warning">Network Security</span>
          <span class="skill-tag skill-tag--warning">Cryptography</span>
          <span class="skill-tag skill-tag--warning">OAuth2 / JWT</span>
        </div>

        <h2 class="title-md section-subheading section-subheading--success">Infrastructure & DevOps</h2>
        <div class="skill-list skill-list-wrapper">
          <span class="skill-tag skill-tag--success">AWS</span>
          <span class="skill-tag skill-tag--success">Azure</span>
          <span class="skill-tag skill-tag--success">Terraform</span>
          <span class="skill-tag skill-tag--success">Kubernetes</span>
          <span class="skill-tag skill-tag--success">Docker</span>
          <span class="skill-tag skill-tag--success">CI/CD</span>
          <span class="skill-tag skill-tag--success">Ansible</span>
          <span class="skill-tag skill-tag--success">Linux</span>
          <span class="skill-tag skill-tag--success">Prometheus</span>
          <span class="skill-tag skill-tag--success">Grafana</span>
          <span class="skill-tag skill-tag--success">IaC</span>
        </div>

        <h2 class="title-md section-subheading section-subheading--hairline">Get In Touch</h2>
        <div class="btn-group social-links-section">
          {socialLinks.map((link, i) => (
            <Button
              text={link.label}
              href={link.href}
              target={link.target ?? undefined}
              rel={link.rel ?? undefined}
              variant={i === 0 ? 'default' : 'secondary'}
            />
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
