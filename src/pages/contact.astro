---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { socialLinks } from '../config';
---

<Layout title="Contact — Ethan Goh">
  <section class="section">
    <div class="container">
      <div class="section-heading"><h1 class="display-lg">Contact</h1></div>
      <p class="caption-uppercase section-subtitle">Get in Touch</p>

      <div class="two-col-grid">
        <!-- Contact Form -->
        <div>
          <h2 class="title-md section-subheading">Send a Message</h2>

          <div id="form-success" class="alert alert-success" style="display: none;">
            <p class="body-md">Message sent successfully! I'll get back to you soon.</p>
          </div>

          <div id="form-error" class="alert alert-warning" style="display: none;">
            <p class="body-md">Something went wrong. Please try again or email me directly.</p>
          </div>

          <form
            action={`https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_FORM_ID || 'YOUR_FORM_ID'}`}
            method="POST"
            id="contact-form"
          >
            <div class="form-field">
              <label for="name" class="form-label">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="form-input"
                placeholder="Your name"
              />
            </div>

            <div class="form-field">
              <label for="email" class="form-label">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="form-input"
                placeholder="your@email.com"
              />
            </div>

            <div class="form-field form-field--xl">
              <label for="message" class="form-label">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="form-input form-textarea"
                placeholder="Your message..."
              ></textarea>
            </div>

            <Button text="Send Message" variant="default" />
          </form>
        </div>

        <!-- Contact Info -->
        <div>
          <h2 class="title-md section-subheading">Other Ways to Reach Me</h2>
          <p class="body-md info-description">
            I'm always open to discussing new projects, creative ideas, or opportunities to be part of something amazing.
          </p>

          <div class="info-item">
            <p class="body-sm info-label">Email</p>
            <p class="body-md info-text">info@cyberitdad.xyz</p>
          </div>

          <div class="info-item">
            <p class="body-sm info-label">Response Time</p>
            <p class="body-md info-text">Usually within 24-48 hours</p>
          </div>

          <div class="info-item">
            <p class="body-sm info-label">Connect</p>
            <div class="btn-group">
              {socialLinks.map((link, i) => (
                <Button
                  text={link.label}
                  href={link.href}
                  target={link.target ?? undefined}
                  rel={link.rel ?? undefined}
                  variant={i === 0 ? 'default' : 'secondary'}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const submitBtn = form?.querySelector('.btn');
  const successAlert = document.getElementById('form-success');
  const errorAlert = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    const formData = new FormData(form);
    submitBtn.textContent = 'Sending...';
    submitBtn.classList.add('btn--loading');
    submitBtn.disabled = true;

    if (successAlert) successAlert.style.display = 'none';
    if (errorAlert) errorAlert.style.display = 'none';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        form.reset();
        if (successAlert) successAlert.style.display = 'block';
      } else {
        if (errorAlert) errorAlert.style.display = 'block';
      }
    } catch {
      if (errorAlert) errorAlert.style.display = 'block';
    } finally {
      submitBtn.textContent = 'Send Message';
      submitBtn.classList.remove('btn--loading');
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .contact-form .btn {
    min-width: 160px;
  }
</style>
