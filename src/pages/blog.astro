---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const POSTS_PER_PAGE = 6;
const totalPosts = sorted.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

let currentPage = 1;
const url = new URL(Astro.url);
const pageParam = url.searchParams.get('page');
if (pageParam && !isNaN(Number(pageParam))) {
  currentPage = Math.max(1, Math.min(Number(pageParam), totalPages));
}

const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const paginatedPosts = sorted.slice(startIndex, startIndex + POSTS_PER_PAGE);

const currentPageUrl = currentPage > 1 ? `?page=${currentPage}` : '';
const prevUrl = currentPage > 1 ? `?page=${currentPage - 1}` : '';
const nextUrl = currentPage < totalPages ? `?page=${currentPage + 1}` : '';
---

<Layout title="Blog — Ethan Goh">
  <section class="section" style="padding-top: 120px;">
    <div class="container">
      <div class="section-heading"><h1 class="display-lg">Blog</h1></div>
      <p class="caption-uppercase" style="margin-bottom: var(--spacing-xxl); color: var(--color-link);">Thoughts on Security, Infrastructure & Development</p>

      <div class="grid-2">
        {paginatedPosts.map(post => (
          <BlogCard
            title={post.data.title}
            excerpt={post.data.excerpt}
            slug={post.slug}
            date={post.data.date}
            category={post.data.category}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>

      {totalPages > 1 && (
        <div style="display: flex; justify-content: center; align-items: center; gap: var(--spacing-lg); margin-top: var(--spacing-xxl);">
          <a
            href={prevUrl || '#'}
            class="btn {currentPage === 1 ? 'btn-disabled' : ''}"
            style={currentPage === 1 ? 'opacity: 0.4; pointer-events: none;' : ''}
            aria-label="Previous page"
          >
            ← Previous
          </a>

          <span class="body-sm" style="color: var(--color-muted); min-width: 80px; text-align: center;">
            Page {currentPage} of {totalPages}
          </span>

          <a
            href={nextUrl || '#'}
            class="btn {currentPage === totalPages ? 'btn-disabled' : ''}"
            style={currentPage === totalPages ? 'opacity: 0.4; pointer-events: none;' : ''}
            aria-label="Next page"
          >
            Next →
          </a>
        </div>
      )}
    </div>
  </section>
</Layout>
