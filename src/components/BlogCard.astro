---
interface Props {
  title: string;
  excerpt: string;
  slug: string;
  date: string;
  category: string;
  readingTime?: string;
}

const { title, excerpt, slug, date, category, readingTime } = Astro.props;

const categoryClass = category === 'Development' ? 'tag-development' : category === 'Security' ? 'tag-security' : category === 'Infrastructure' ? 'tag-infrastructure' : category === 'Life Lessons' ? 'tag-lifelessons' : '';

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="card-link">
  <div class="card">
    <div class="card-meta-row">
      <span class="tag {categoryClass}">{category}</span>
      <div class="card-meta-inline">
        {readingTime && <span class="date-pill">{readingTime}</span>}
        <span class="date-pill">{formattedDate}</span>
      </div>
    </div>
    <h3 class="title-md card-title">{title}</h3>
    <p class="body-md">{excerpt}</p>
  </div>
</a>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
</style>
