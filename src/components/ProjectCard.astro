---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  slug: string;
  imageAlt?: string;
  date?: string;
  techColors?: string[];
  visualTheme?: string;
}

const { title, description, techStack, slug, imageAlt = 'Project image', date, techColors, visualTheme } = Astro.props;

const themeClass = visualTheme ? `card-image-placeholder theme-${visualTheme}` : 'card-image-placeholder';

const techColorToClass: Record<string, string> = {
  'var(--color-link)': 'skill-tag--link',
  'var(--color-warning)': 'skill-tag--warning',
  'var(--color-success)': 'skill-tag--success',
  'var(--color-body)': 'skill-tag--body',
};
---

<a href={`/projects/${slug}`} class="card-link" aria-label={`View project: ${title}`}>
  <div class="card">
    <div class={themeClass} aria-hidden="true">
      {visualTheme === 'secureci' && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 17 10 11 4 5"/>
          <line x1="12" y1="19" x2="20" y2="19"/>
        </svg>
      )}
      {visualTheme === 'cloudforge' && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="8" rx="2"/>
          <rect x="2" y="14" width="20" height="8" rx="2"/>
          <circle cx="6" cy="6" r="1" fill="currentColor" stroke="none"/>
          <circle cx="6" cy="18" r="1" fill="currentColor" stroke="none"/>
        </svg>
      )}
      {visualTheme === 'netsentinel' && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
      )}
      {visualTheme === 'vaultguard' && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 10a2 2 0 0 0-2 2c0 1.07.93 2 2 2s2-.93 2-2a2 2 0 0 0-2-2z"/>
          <path d="M12 2a9 9 0 0 0-9 9c0 3.5 2 6.5 5 8.25V22h8v-2.75c3-1.75 5-4.75 5-8.25a9 9 0 0 0-9-9z"/>
          <path d="M12 5a6 6 0 0 0-6 6c0 2.5 1.5 5 4 6.25"/>
          <path d="M12 5a6 6 0 0 1 6 6c0 2.5-1.5 5-4 6.25"/>
        </svg>
      )}
      {!visualTheme && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 17 10 11 4 5"/>
          <line x1="12" y1="19" x2="20" y2="19"/>
        </svg>
      )}
    </div>
    <div class="card-content">
      {date && <p class="date-pill card-date">{date}</p>}
      <h3 class="title-md card-title">{title}</h3>
      <p class="body-md card-description">{description}</p>
      <div class="skill-list">
        {techStack.map((tech, i) => (
          <span class:list={['skill-tag', techColorToClass[techColors?.[i] || ''] || '']}>{tech}</span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
</style>
