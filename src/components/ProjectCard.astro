---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  slug: string;
  imageAlt?: string;
  date?: string;
  techColors?: string[];
}

const { title, description, techStack, slug, imageAlt = 'Project image', date, techColors } = Astro.props;
---

<a href={`/projects/${slug}`} class="card-link">
  <div class="card">
    <div class="card-image-placeholder" aria-hidden="true">Project</div>
    <div style="margin-top: var(--spacing-lg);">
      {date && <p class="date-pill" style="margin-bottom: var(--spacing-sm);">{date}</p>}
      <h3 class="title-md" style="margin-bottom: var(--spacing-sm);">{title}</h3>
      <p class="body-md" style="margin-bottom: var(--spacing-md);">{description}</p>
      <div class="skill-list" style="gap: var(--spacing-xs);">
        {techStack.map((tech, i) => (
          <span class="skill-tag" style={techColors && techColors[i] ? `border-color: ${techColors[i]}; color: ${techColors[i]};` : ''}>{tech}</span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
</style>
