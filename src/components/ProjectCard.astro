---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  slug: string;
  imageAlt?: string;
  date?: string;
  techColors?: string[];
  visualTheme?: string;
}

const { title, description, techStack, slug, imageAlt = 'Project image', date, techColors, visualTheme } = Astro.props;

const themeClass = visualTheme ? `card-image-placeholder theme-${visualTheme}` : 'card-image-placeholder';
---

<a href={`/projects/${slug}`} class="card-link" aria-label={`View project: ${title}`}>
  <div class="card">
    <div class={themeClass} aria-hidden="true">
      {visualTheme === 'secureci' && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/>
          <path d="M2 12l10 5 10-5"/>
        </svg>
      )}
      {visualTheme === 'cloudforge' && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
        </svg>
      )}
      {visualTheme === 'netsentinel' && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      )}
      {visualTheme === 'vaultguard' && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          <circle cx="12" cy="16" r="1"/>
        </svg>
      )}
      {!visualTheme && (
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      )}
    </div>
    <div style="margin-top: var(--spacing-lg);">
      {date && <p class="date-pill" style="margin-bottom: var(--spacing-sm);">{date}</p>}
      <h3 class="title-md" style="margin-bottom: var(--spacing-sm);">{title}</h3>
      <p class="body-md" style="margin-bottom: var(--spacing-md);">{description}</p>
      <div class="skill-list" style="gap: var(--spacing-xs);">
        {techStack.map((tech, i) => (
          <span class="skill-tag" style={techColors && techColors[i] ? `border-color: ${techColors[i]}; color: ${techColors[i]};` : ''}>{tech}</span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
</style>
