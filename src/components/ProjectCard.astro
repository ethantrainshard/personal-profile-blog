---
import { projectThemes } from '../config';

const base = import.meta.env.BASE_URL.trimEnd('/');

interface Props {
  title: string;
  description: string;
  techStack: string[];
  slug: string;
  imageAlt?: string;
  date?: string;
  techColors?: string[];
  visualTheme?: string;
}

const { title, description, techStack, slug, imageAlt = 'Project image', date, techColors, visualTheme } = Astro.props;

const themeKey = visualTheme && projectThemes[visualTheme] ? visualTheme : 'default';
const theme = projectThemes[themeKey];
const themeClass = visualTheme ? `card-image-placeholder theme-${visualTheme}` : 'card-image-placeholder';

const techColorToClass: Record<string, string> = {
  'var(--color-link)': 'skill-tag--link',
  'var(--color-warning)': 'skill-tag--warning',
  'var(--color-success)': 'skill-tag--success',
  'var(--color-body)': 'skill-tag--body',
};
---

<a href={`${base}/projects/${slug}`} class="card-link" aria-label={`View project: ${title}`}>
  <div class="card">
    <div class={themeClass} aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={theme.icon}></svg>
    </div>
    <div class="card-content">
      {date && <p class="date-pill card-date">{date}</p>}
      <h3 class="title-md card-title">{title}</h3>
      <p class="body-md card-description">{description}</p>
      <div class="skill-list">
        {techStack.map((tech, i) => (
          <span class:list={['skill-tag', techColorToClass[techColors?.[i] || ''] || '']}>{tech}</span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
</style>
