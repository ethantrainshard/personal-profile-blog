---
interface Props {
  date: string;
  title: string;
  company: string;
  location?: string;
  description: string;
  bulletPoints?: string[];
  technologies?: string[];
  techColors?: string[];
}

const { date, title, company, location, description, bulletPoints, technologies, techColors } = Astro.props;

const locationText = location ? ` \u2014 ${location}` : '';

const techColorToClass: Record<string, string> = {
  'var(--color-link)': 'skill-tag--link',
  'var(--color-warning)': 'skill-tag--warning',
  'var(--color-success)': 'skill-tag--success',
  'var(--color-body)': 'skill-tag--body',
};
---

<div class="timeline-entry">
  <p class="caption-uppercase timeline-date">{date}</p>
  <h3 class="title-md timeline-title">{title}</h3>
  <p class="body-md timeline-company">{company}{locationText}</p>
  <p class="body-md timeline-description">{description}</p>
  {bulletPoints && bulletPoints.length > 0 && (
    <ul class="timeline-bullets">
      {bulletPoints.map((point) => (
        <li class="body-md">{point}</li>
      ))}
    </ul>
  )}
  {technologies && technologies.length > 0 && (
    <div class="skill-list">
      {technologies.map((tech, i) => (
        <span class:list={['skill-tag', techColorToClass[techColors?.[i] || ''] || '']}>{tech}</span>
      ))}
    </div>
  )}
</div>
