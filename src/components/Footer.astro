---
import { navLinks, socialLinks, focusAreas } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h3 class="footer-heading">Navigation</h3>
        <ul class="footer-links">
          {navLinks.map(link => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h3 class="footer-heading">Connect</h3>
        <ul class="footer-links">
          {socialLinks.map(link => (
            <li>
              <a
                href={link.href}
                target={link.target}
                rel={link.rel}
                class="footer-link"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h3 class="footer-heading">Focus Areas</h3>
        <ul class="footer-links">
          {focusAreas.map(area => (
            <li><a href={area.href} class="footer-link">{area.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <hr class="hairline footer-divider" />
    <div class="footer-bottom">
      <p class="footer-copyright">Copyright {currentYear} Ethan Goh. All rights reserved.</p>
      <div class="footer-legal">
        <a href="#" class="footer-link">Privacy</a>
        <a href="#" class="footer-link">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-canvas);
    padding: var(--spacing-xxl) 0 var(--spacing-xl);
    border-top: 1px solid var(--color-hairline);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xxl);
  }

  .footer-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.3;
    letter-spacing: 0.125rem;
    text-transform: uppercase;
    color: var(--color-on-dark);
    margin-bottom: var(--spacing-lg);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-link {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  .footer-link:hover {
    color: var(--color-on-dark);
  }

  .footer-divider {
    margin: var(--spacing-xxl) 0 var(--spacing-xl);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copyright {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted-soft);
  }

  .footer-legal {
    display: flex;
    gap: var(--spacing-md);
  }
</style>

<style>
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-xxl);
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--spacing-md);
      text-align: center;
    }
  }
</style>
